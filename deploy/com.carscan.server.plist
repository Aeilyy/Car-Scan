<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.carscan.server</string>
  <key>ProgramArguments</key>
  <array><string>/Users/YOUR_USER/carscan/server/run.sh</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/carscan.log</string>
  <key>StandardErrorPath</key><string>/tmp/carscan.log</string>
</dict>
</plist>
